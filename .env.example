# LeaseQueue configuration template.
#
# Settings are read from the process environment (pydantic-settings, prefix
# LEASEQUEUE_). This file is not loaded automatically: export the values in
# your shell, or pass a copy to Docker with `docker run --env-file .env`.
# The values below are the defaults from src/leasequeue/config.py.

# SQLite database file. The Dockerfile image sets /data/leasequeue.db and
# Dockerfile.vercel uses /tmp/leasequeue.db.
LEASEQUEUE_DATABASE_PATH=leasequeue.db

# Set to "production" to disable the interactive API docs at /docs.
LEASEQUEUE_ENVIRONMENT=development

# Content-length guard for request bodies, in bytes (4096-1048576).
LEASEQUEUE_MAX_REQUEST_BYTES=131072
